{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "i18n/**/*.ts",
    "messages/**/*.json",
    "middleware.ts",
    "next.config.ts",
    "open-next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "custom-worker.ts",
    ".open-next/**",
    ".wrangler/**"
  ]
}
